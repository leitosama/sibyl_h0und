# Copy to a per-agent profile and fill in your values:
#   cp .env.example .env.h0und2   # development token, used until the competition
#   cp .env.example .env.h0und1   # competition token, clean statistics from October 10
# Never commit .env or .env.* profiles.

# Competition runtime. Take the address and the key from the competition site.
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-your-key
SCENARIO_RUNTIME_VERIFY_TLS=true
# Optional: choose a specific competition arena instead of the currently open default.
# SCENARIO_RUNTIME_ARENA=practice
# For .env.h0und1 set the competition arena explicitly: practice is still open
# on October 10. The arena name will be announced in the competition chat.

GRPC_DNS_RESOLVER=native
REMOTE_RUN_LABEL=h0und2
# Shown next to your runs in the competition interface.
AGENT_NAME=h0und2

# OpenAI-compatible LLM provider. All three are required.
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_DEFAULT_MODEL=provider/model-name

# Optional limits.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_COMPLETION_TOKENS=16384
LLM_MAX_STEP_RETRIES=3
# Safety ceiling on runtime calls per task, the report included; must stay below 100.
BLUESEC_AGENT_MAX_RUNTIME_CALLS=95

# Investigation traces, one JSONL file per task. Keep them outside the repository.
# TRACE_ENABLED=true
# TRACE_DIR=~/.local/share/sibyl_h0und/traces
